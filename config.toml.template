[build]
rustflags = [
  "-C", "link-args=../../../runtime/build/libs/runtime-0.1.0.jar",
  "-C", "strip=none",
  "-Z", "unstable-options", "--jobs-frontend=4",
  "-Z", "share-generics=yes",
  "-Z", "inline-mir=no"
]

# Rust panics cross JVM frames as exceptions and are caught by panic_unwind.
[profile]
panic = "unwind"
